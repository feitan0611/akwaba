# Copier ce fichier en .env (jamais versionné) puis adapter.
LANGCI_ENVIRONMENT=dev
# Moteur IA : mock (factice) ou local (vrais modèles : pip install -r backend/requirements-ml.txt)
LANGCI_ENGINE=mock
# Moteur local : précharger les modèles au démarrage (sinon à la première requête)
LANGCI_PRELOAD_MODELS=false
# LLM local servi par Ollama
LANGCI_OLLAMA_URL=http://127.0.0.1:11434
LANGCI_OLLAMA_MODEL=qwen2.5:3b
# Langue pivot utilisée par le LLM : fra | eng
LANGCI_PIVOT_LANGUAGE=fra
LANGCI_MAX_AUDIO_MB=10
LANGCI_CORS_ORIGINS=["*"]
LANGCI_SERVE_DEMO=true
# Secret du LLM hébergé éventuel — ne JAMAIS le committer
LANGCI_LLM_API_KEY=

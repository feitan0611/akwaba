# Copier ce fichier en .env (jamais versionné) puis adapter.
LANGCI_ENVIRONMENT=dev
# Moteur IA : mock (factice) tant que les modèles ne sont pas intégrés
LANGCI_ENGINE=mock
# Langue pivot utilisée par le LLM : fra | eng
LANGCI_PIVOT_LANGUAGE=fra
LANGCI_MAX_AUDIO_MB=10
LANGCI_CORS_ORIGINS=["*"]
LANGCI_SERVE_DEMO=true
# Secret du LLM hébergé éventuel — ne JAMAIS le committer
LANGCI_LLM_API_KEY=
